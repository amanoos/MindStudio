{
  "name": "mind-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "content:lint": "node scripts/content-lint.js",
    "content:links": "node scripts/check-links.js",
    "export": "echo \"export not implemented yet (T16)\"",
    "import": "echo \"import not implemented yet (T16)\""
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "canvas-confetti": "^1.9.4",
    "lucide-svelte": "^1.0.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
