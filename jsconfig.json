{
  "extends": "$app/tsconfig",
  "include": [
    "src",
    "tests",
    "scripts",
    "vite.config.js",
    "eslint.config.js",
    "playwright.config.js"
  ],
  "exclude": ["src/service-worker", "build"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true
  }
}
