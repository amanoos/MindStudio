# Copy to .env for local use. Never commit the real .env.

# Passcode you type on the login page.
APP_PASSCODE=change-me

# Random string, 16+ characters, used to sign the login cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Local SQLite file (default) or a Turso database for the cloud.
DATABASE_URL=file:data/app.db
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=

# IANA timezone that defines "today" for your five words.
DEFAULT_TIMEZONE=UTC

# Docker on localhost only: the host port to publish (default 3000).
# HOST_PORT=3000
